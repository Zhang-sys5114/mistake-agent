# 服务端配置（开发期：复制为 .env；生产经 systemd EnvironmentFile 注入）
# 配置来源唯一：环境变量（ADR-0047 决策 2）。启动时一次性读取并校验，缺失/非法即拒绝启动。

# 必需：PostgreSQL 连接串
DATABASE_URL=postgres://mistake:mistake@127.0.0.1:5432/mistake_agent

# 监听地址（生产由反向代理 Caddy 终结 TLS，服务端只听回环）
BIND_ADDR=127.0.0.1:8080

# 连接池上限
DB_MAX_CONNECTIONS=10

# 日志级别（等同 RUST_LOG 的简写；RUST_LOG 存在时优先）
LOG_LEVEL=info

# 登录令牌有效期（天）：桌面端长期在线，默认 90
TOKEN_TTL_DAYS=90

# 首个管理员种子：两者都配齐且该邮箱未注册时，启动会创建管理员账号（按邮箱幂等）。
# 不配则不创建；已有同邮箱普通账号时只告警、不提权（提权走 admin CLI，S4）。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 平台 DeepSeek 密钥与上游地址：S3 中转使用。留空则中转请求全部 502。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 中转强制使用的模型（不信任客户端传来的 model）
DEEPSEEK_MODEL=deepseek-flash

# 阶梯扣次的 token 阈值（升序，逗号分隔；留空 = 不设阶梯，一律扣 1 次）
BILLING_LADDER_TOKENS=32768,65536

# 中转请求体上限（字节）：图片以 base64 内联，32 MiB 够放几张手机原图
RELAY_MAX_BODY_BYTES=33554432
# 同一用户同时在飞的中转请求上限
RELAY_MAX_CONCURRENT_PER_USER=2

# ── 安全护栏 ────────────────────────────────────────────────────────────────
# 是否信任 X-Forwarded-For / X-Real-IP。只有在反向代理（Caddy）后面才设 true，
# 否则任何人都能伪造来源 IP 绕过按 IP 的限流与封禁。
SECURITY_TRUST_PROXY=false
# 令牌桶：账号面按 IP（注册/登录）
SECURITY_AUTH_RATE_PER_MINUTE=30
SECURITY_AUTH_BURST=10
# 令牌桶：中转面按用户与按 IP（突发容量取一分钟的持续速率，能吸收"一轮工具调用连发"）
SECURITY_RELAY_RATE_PER_MINUTE=60
SECURITY_RELAY_BURST=60
# 登录失败封禁：5 次 / 10 分钟窗口 → 封 15 分钟（进程内；长期封禁交给 fail2ban）
SECURITY_LOGIN_MAX_FAILURES=5
SECURITY_LOGIN_FAILURE_WINDOW_SECS=600
SECURITY_LOGIN_BLOCK_SECS=900
# 全局同时在飞的中转请求上限（保护上游账号与进程容量）
SECURITY_MAX_CONCURRENT_GLOBAL=200
