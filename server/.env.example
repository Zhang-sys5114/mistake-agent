# 服务端配置（开发期：复制为 .env；生产经 systemd EnvironmentFile 注入）
# 配置来源唯一：环境变量（ADR-0047 决策 2）。启动时一次性读取并校验，缺失/非法即拒绝启动。

# 必需：PostgreSQL 连接串
DATABASE_URL=postgres://mistake:mistake@127.0.0.1:5432/mistake_agent

# 监听地址（生产由反向代理 Caddy 终结 TLS，服务端只听回环）
BIND_ADDR=127.0.0.1:8080

# 连接池上限
DB_MAX_CONNECTIONS=10

# 日志级别（等同 RUST_LOG 的简写；RUST_LOG 存在时优先）
LOG_LEVEL=info

# 登录令牌有效期（天）：桌面端长期在线，默认 90
TOKEN_TTL_DAYS=90

# 首个管理员种子：两者都配齐且该邮箱未注册时，启动会创建管理员账号（按邮箱幂等）。
# 不配则不创建；已有同邮箱普通账号时只告警、不提权（提权走 admin CLI，S4）。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 平台 DeepSeek 密钥与上游地址：S3 中转使用。S1/S2 允许为空（仅告警），S3 上线后必需。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
